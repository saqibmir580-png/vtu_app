# ====================================================================
# VTU Student Super App - Environment Variables Template
# ====================================================================

# 1. Environment Identifier ('development' | 'preview' | 'production')
EXPO_PUBLIC_APP_ENV=development

# 2. API Base URL for Mobile App
# Development: http://localhost:5000/api/v1 (or LAN: http://192.168.1.x:5000/api/v1)
# Staging/Preview: https://vtu-backend-staging.voroa.app/api/v1
# Production: https://api.vtuapp.in/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# 3. Google OAuth Web Client ID (Required for Backend verification and Web fallback)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# 4. Google OAuth Native Android Client ID (Google Cloud Console -> Android Client)
# Requires Package Name: com.vtu.studentapp and SHA-1 certificate fingerprint
EXPO_PUBLIC_ANDROID_CLIENT_ID=

# 5. Google OAuth Native iOS Client ID (Google Cloud Console -> iOS Client)
# Requires Bundle Identifier: com.vtu.studentapp
EXPO_PUBLIC_IOS_CLIENT_ID=

# 6. OAuth Redirect URI:
# - Leave BLANK for Standalone / EAS Production / Dev Client builds (auto-resolves 'vtuapp://' or iOS reversed client ID)
# - For Expo Go testing: https://auth.expo.io/@mohammed_fardeen_02/vtu-student-super-app
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=
