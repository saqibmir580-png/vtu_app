# ====================================================================
# VTU Student Super App - ENVIRONMENT TEMPLATE (.env.example)
# ====================================================================
# Mirrors the backend environment convention (vtu-backend):
#   - .env.development  (Local development and Metro bundler)
#   - .env.test         (Automated test runs, staging QA preview APKs)
#   - .env.production   (Production builds, release bundles, Google Play)

# 1. Environment Identifier ('development' | 'test' | 'production')
EXPO_PUBLIC_APP_ENV=development

# 2. Backend API URL
# - Development: http://localhost:5000/api/v1 (or LAN: http://192.168.x.x:5000/api/v1)
# - Test / Preview: https://vtu-backend-staging.voroa.app/api/v1 (or local test: http://localhost:5001/api/v1)
# - Production: https://api.vtuapp.in/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# 3. Google OAuth Web Client ID (Required for Backend token verification)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# 4. Google OAuth Native Android Client ID (Google Cloud Console -> Android Client)
# Requires Package Name: com.vtu.studentapp and SHA-1 certificate fingerprint
EXPO_PUBLIC_ANDROID_CLIENT_ID=

# 5. Google OAuth Native iOS Client ID (Google Cloud Console -> iOS Client)
# Requires Bundle Identifier: com.vtu.studentapp
EXPO_PUBLIC_IOS_CLIENT_ID=

# 6. OAuth Redirect URI:
# - Leave BLANK for Standalone / EAS Production / Dev Client builds (auto-resolves 'vtuapp://' or iOS scheme)
# - For Expo Go testing: https://auth.expo.io/@your_expo_username/vtu-student-super-app
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=

# 7. Razorpay Key ID (Client-side checkout key)
# Test: rzp_test_...
# Live: rzp_live_...
EXPO_PUBLIC_RAZORPAY_KEY_ID=
