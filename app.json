{
  "expo": {
    "name": "VTU Super App",
    "slug": "vtu-student-super-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vtuapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0732B8"
    },
    "ios": {
      "bundleIdentifier": "com.vtu.studentapp",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.170442859744-jfj3r0uh28c0b8vbhf5rsn22ceokj2tr"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.vtu.studentapp",
      "edgeToEdge": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
